# Copy to .env and fill in. docker-compose.yml reads this file.
#
#   cp .env.example .env
#
# .env is gitignored because it holds an API key. Keep it that way.

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# The host running docker — where jetio and the Stremio streaming server live.
# jetio redirects Jellyfin and every playback device here, so it must be this
# machine's real LAN address. Not localhost, not a docker service name.
#   ip -4 addr show scope global
JETIO_HOST_IP=192.168.1.10

# The host running Jellyfin. Same value as JETIO_HOST_IP if they share a machine.
# Used only so jetio can ask Jellyfin to rescan.
JELLYFIN_IP=192.168.1.20

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where the .strm tree is written. Jellyfin must be able to READ this exact
# directory, so if Jellyfin runs on another machine this has to be shared
# storage (NFS/SMB/virtiofs), not a local folder.
#
# jetio creates and owns these beneath it:
#   Movies/        Shows/        Kids/Movies/        Kids/Shows/
#
# Give it its own directory. Anything in here that jetio does not recognise
# gets pruned, so never point it at a folder holding real media.
JETIO_LIBRARY_PATH=/srv/jetio-library

# ---------------------------------------------------------------------------
# Jellyfin
# ---------------------------------------------------------------------------

# Jellyfin Dashboard -> API Keys -> "+", name it "jetio", paste the key here.
# Leave empty to skip automatic rescans; you would then rescan by hand.
JELLYFIN_API_KEY=

# The jetio libraries in Jellyfin, exactly as named there. Only these get rescanned.
# Leave empty and EVERY library is rescanned instead, which takes minutes on a server
# that also holds a real media collection.
JELLYFIN_LIBRARY_NAMES=jetio Films,jetio Shows,jetio Kids Films,jetio Kids Shows
